# ============================================================
# SoloBooks Staging Environment Variables
# Copy this file to .env.staging.local and fill in secrets.
# NEVER commit .env.staging / .env.staging.local to git.
# ============================================================

# ----- Required: LLM API Keys -----
# DashScope (Qwen) — https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# Zhipu (OCR) — https://open.bigmodel.cn/ (Ocr service)
ZHIPU_API_KEY=your-zhipu-api-key

# ----- Optional: LLM Provider (OpenAI-compatible endpoint, provider-agnostic) -----
# All text/multimodal LLM calls go through one OpenAI-compatible endpoint.
# Switch to DeepSeek / GLM by changing these; business code stays untouched.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your-llm-api-key            # falls back to DASHSCOPE_API_KEY when empty
# QWEN_TEXT_MODEL=qwen-plus
# QWEN_VL_MODEL=qwen-vl-plus

# ----- Required: JWT -----
JWT_SECRET=replace-with-a-long-random-string

# ----- Optional: WeChat Mini Program -----
# Personal developer subject: only appid + secret needed for code2session
WECHAT_APPID=
WECHAT_SECRET=

# ----- Optional: Aliyun SMS (Dypnsapi) -----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ----- Model names (optional, defaults shown) -----
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus
