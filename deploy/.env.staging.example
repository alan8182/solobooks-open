# ============================================================
# SoloBooks Staging Environment Variables
# Copy this file to .env.staging.local and fill in secrets.
# NEVER commit .env.staging / .env.staging.local to git.
# ============================================================

# ----- Required: LLM API Keys -----
# DashScope (Qwen) — https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# Zhipu (OCR) — https://open.bigmodel.cn/ (Ocr service)
ZHIPU_API_KEY=your-zhipu-api-key

# ----- Required: JWT -----
JWT_SECRET=replace-with-a-long-random-string

# ----- Optional: WeChat Mini Program -----
# Personal developer subject: only appid + secret needed for code2session
WECHAT_APPID=
WECHAT_SECRET=

# ----- Optional: Aliyun SMS (Dypnsapi) -----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ----- Model names (optional, defaults shown) -----
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus
