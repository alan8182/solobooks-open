# ============================================================
# SoloBooks Staging Environment Variables
# Copy this file to .env.staging.local and fill in secrets.
# NEVER commit .env.staging / .env.staging.local to git.
# ============================================================

# ----- Required: LLM API Keys -----
# DashScope (Qwen) — https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# Zhipu (OCR) — https://open.bigmodel.cn/ (Ocr service)
ZHIPU_API_KEY=your-zhipu-api-key

# ----- Required: JWT -----
JWT_SECRET=replace-with-a-long-random-string

# ----- Optional: WeChat Mini Program -----
# Personal developer subject: only appid + secret needed for code2session
WECHAT_APPID=
WECHAT_SECRET=

# ----- Optional: WeChat Open Platform website app (PC QR login) -----
# AppID/AppSecret 来自 open.weixin.qq.com「网站应用」；不要填微信支付的 appid。
# 两项齐全登录入口才出现；授权回调域必须是 solobooks.cn。
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=

# ----- Optional: Alipay (PC website payment) -----
# APP_ID/PRIVATE_KEY/PUBLIC_KEY 三项齐备支付宝渠道才启用；GATEWAY 留空走生产网关
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# ----- Optional: WeChat Pay APIv3 (Native 扫码，第二渠道) -----
# 五项 MCH_ID/APP_ID/API_V3_KEY/SERIAL_NO/PRIVATE_KEY 齐备才启用；
# APP_ID 必须是商户平台「AppID 账号管理」里已与商户号绑定的公众号/小程序/移动应用，
# 不能填登录用的网站应用 appid（WECHAT_WEB_APPID），个人主体小程序也无法绑定。
# PUBLIC_KEY/PUBLIC_KEY_ID 可选：新版商户平台公钥模式；留空回退平台证书运行时拉取。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_ORDER_TIMEOUT=2h

# ----- Optional: Aliyun SMS (Dypnsapi) -----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ----- Model names (optional, defaults shown) -----
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus
