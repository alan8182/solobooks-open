# 阿里云百炼平台 API Key
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# 智谱开放平台 API Key（拍单据：智谱 OCR + 通义文本结构化）
# 获取与 OCR 说明：https://open.bigmodel.cn/ （控制台创建 API Key）
ZHIPU_API_KEY=your-zhipu-api-key-here

# 模型（可选）
# QWEN_VL_MODEL=qwen-vl-plus
# QWEN_TEXT_MODEL=qwen-plus
#
# ── LLM 供应商（OpenAI 兼容协议，供应商无关）─────────────────────────
# 所有文本/多模态 LLM 调用统一走 OpenAI 兼容端点。切换 DeepSeek / GLM 等
# 供应商只需改下面三项（+ 文本/视觉模型名），业务代码零改动：
#
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 通义（默认示例）
#   DeepSeek 示例:  https://api.deepseek.com/v1
#   智谱 GLM 示例:  https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=your-llm-api-key            # 不填则复用 DASHSCOPE_API_KEY
# QWEN_TEXT_MODEL=qwen3.8-flash           # 文本 + agent 循环
# QWEN_VL_MODEL=qwen3.8-flash             # 视觉/多模态（qwen3.8-flash 本身支持图片）
# QWEN_ENABLE_THINKING=true               # agent 深度思考开关（同步 JSON 调用恒为关）

# 服务端口（可选）
# PORT=8000

# 微信小程序（code2session，个人主体仅需 appid + secret）
# WECHAT_APPID=
# WECHAT_SECRET=

# JWT（生产环境请务必改为高强度随机串）
# JWT_SECRET=
# JWT_EXPIRES_IN=604800

# 阿里云号码认证短信（Dypnsapi）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_SCHEME_NAME=默认方案
# ALIYUN_SMS_CODE_VALID_SECONDS=300
# ALIYUN_SMS_INTERVAL_SECONDS=60

# ── 社保公积金口径（工资模块草稿测算，按当地标准调整）────────────────
# SOCIAL_COMPANY_RATE=0.25        # 单位社保（养老16+医疗8+失业0.5+工伤0.5）
# SOCIAL_PERSONAL_RATE=0.105      # 个人社保（养老8+医疗2+失业0.5）
# HF_COMPANY_RATE=0.08            # 单位公积金（5%-12% 常见）
# HF_PERSONAL_RATE=0.08           # 个人公积金（旧版缺漏，现已纳入个人扣款）
# SOCIAL_SECURITY_BASE_MIN=0      # 缴费基数下限（当地社平60%，0=不限）
# SOCIAL_SECURITY_BASE_MAX=0      # 缴费基数上限（当地社平300%，0=不限）
# RD_DEPARTMENTS=研发部            # 研发部门名单（逗号分隔，计提需登记工时）
