# 阿里云百炼平台 API Key
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# 智谱开放平台 API Key（拍单据：智谱 OCR + 通义文本结构化）
# 获取与 OCR 说明：https://open.bigmodel.cn/ （控制台创建 API Key）
ZHIPU_API_KEY=your-zhipu-api-key-here

# 模型（可选）
# QWEN_VL_MODEL=qwen-vl-plus
# QWEN_TEXT_MODEL=qwen-plus

# 服务端口（可选）
# PORT=8000

# 微信小程序（code2session，个人主体仅需 appid + secret）
# WECHAT_APPID=
# WECHAT_SECRET=

# JWT（生产环境请务必改为高强度随机串）
# JWT_SECRET=
# JWT_EXPIRES_IN=604800

# 阿里云号码认证短信（Dypnsapi）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_SCHEME_NAME=默认方案
# ALIYUN_SMS_CODE_VALID_SECONDS=300
# ALIYUN_SMS_INTERVAL_SECONDS=60
